# ========================================================
# SSchat.box Frontend — Production Environment Variables
# Platform: Vercel / Netlify / Custom Domain
# ========================================================

# Public URL of deployed backend (Render / Railway)
# Must include https:// and NO trailing slash
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# Canonical Public Website URL (For Google Search indexing & sitemap generation)
NEXT_PUBLIC_SITE_URL=https://sschatbox.vercel.app
