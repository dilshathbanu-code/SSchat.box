# ========================================================
# SSchat.box Backend — Production Environment Variables
# Platform: Render / Railway / Docker / Linux VPS
# ========================================================

# Flask & Server Environment
FLASK_ENV=production
DEBUG=false
PORT=5000

# Cryptographic Secrets (Generate a strong 64-character random string)
# Command to generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_char_secret_key_here
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_jwt_secret_here

# Allowed CORS Origins (Comma-separated for multiple domains)
# Example: https://sschatbox.vercel.app,https://your-custom-domain.edu
CORS_ORIGIN=https://sschatbox.vercel.app

# Database Configuration (Choose one):
# 1. Default: Leave blank to use integrated high-concurrency SQLite WAL engine in backend/data/
# 2. Managed PostgreSQL (Render PostgreSQL, Neon, Supabase):
DATABASE_URL=
# 3. MongoDB Atlas (Optional):
MONGODB_URI=

# External AI Provider (Optional: Google Gemini 1.5 Flash for grounded synthesis)
# Leave blank to use SSchat.box verified local RAG engine (Zero Hallucination)
GEMINI_API_KEY=
